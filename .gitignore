# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Runtime data
*.sqlite
*.sqlite-journal
*.db
*.jsonl
*.log
contacts_cache/
event_log/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Phase 0 spike results aren't committed — they have personal data (contacts, SMS)
spike/results/
spike/results/**

# Per-machine config
config.local.toml

# OpenBubbles / iMessage registration material. These plists contain the
# Apple ID auth tokens, IDS identity keys and the rented Mac's hardware
# identifiers — losing them means re-registering, leaking them means
# someone else can send as this Apple ID. Never commit.
data/openbubbles-registration-backup/
data/openbubbles-registration-*.tar.gz
data/imessage-state/

# Vendored third-party Rust sources for the iMessage helper. rustpush is
# Apache-2.0 upstream (OpenBubbles/rustpush) with closed-source stubs for
# open-absinthe and clearadi; vendored rather than committed so the repo
# doesn't carry someone else's tree.
rust/rustpush/
rust/*/target/

# Working notes for AI agents and humans (CLAUDE.md is a symlink to AGENTS.md).
# Local-only: the live-messaging rule names the owner's real phone number, and
# that rule only works if the number in it is the real one — so the file stays
# off any published fork rather than being sanitized into uselessness.
AGENTS.md
CLAUDE.md

# extra cargo build dirs used while the service runs from target-next
rust/ib-imessage/target-next*/
